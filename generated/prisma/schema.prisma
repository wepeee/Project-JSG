// --- Master Item (unified RAW/WIP/FG/CONSUMABLE) ---
// Material table has been merged into Item.

// --- Master Item (unified RAW/WIP/FG/CONSUMABLE) ---

enum ItemKind {
  RAW
  WIP
  FG
  CONSUMABLE
}

enum ItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Item {
  id      Int        @id @default(autoincrement())
  code    String     @unique // Immutable identifier (PN, material name, etc.)
  name    String // Human-readable display name
  kind    ItemKind
  status  ItemStatus @default(DRAFT)
  baseUom String? // Optional base UoM (string for now)

  // Audit
  createdById String? // Who created this item
  createdBy   User?   @relation("ItemCreator", fields: [createdById], references: [id])
  createdFrom String? // "PPIC" | "BACKFILL" | "MASTER" etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  inventoryTxns   InventoryTxn[]
  fgPros          Pro[]            @relation("ProFgItem")
  outputProses    Proses[]         @relation("ProsesOutputItem")
  prosesMaterials ProsesMaterial[] @relation("ProsesMaterialItem")

  @@index([kind])
  @@index([status])
}

enum ProStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
  CLOSED
  CANCELLED
}

model ProPrefix {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(2) // WAJIB 2 digit: "11"
  name String @unique

  type ProType @default(PAPER)

  pros     Pro[]
  machines Machine[] @relation("MachineDefaultPrefix")
}

model ProSequence {
  // prefix = (processCode 2 digit) + (MM 2 digit) + (YY 2 digit) = 6 digit
  prefix String @id @db.VarChar(6)
  last   Int
}

enum ProType {
  PAPER
  RIGID
  OTHER
}

model Pro {
  id          Int       @id @default(autoincrement())
  proNumber   String    @unique @db.VarChar(9)
  productName String
  partNumber  String? // Legacy snapshot: FG Part Number
  qtyPoPcs    Int
  startDate   DateTime?
  status      ProStatus @default(OPEN)
  type        ProType   @default(PAPER)

  autoShiftExpansion Boolean @default(false)

  // Flag untuk menandai PRO dibuat dengan otomatisasi shift

  proPrefixId Int?
  proPrefix   ProPrefix? @relation(fields: [proPrefixId], references: [id])

  // FK to Item master for FG
  fgItemId Int?
  fgItem   Item? @relation("ProFgItem", fields: [fgItemId], references: [id])

  // Audit
  createdById String?
  createdBy   User?   @relation("ProCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ProUpdater", fields: [updatedById], references: [id])

  proses Proses[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryTxns InventoryTxn[]
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  VOID
}

model Proses {
  id    Int @id @default(autoincrement())
  proId Int
  pro   Pro @relation(fields: [proId], references: [id], onDelete: Cascade)

  orderNo Int // 1,2,3...

  up              Int?
  estimatedShifts Int?
  plannedQtyPcs   Int?

  startDate DateTime?

  machineId Int?
  machine   Machine? @relation(fields: [machineId], references: [id])

  partNumber String? // Legacy snapshot: step output Part Number
  batchNo    String?

  // FK to Item master for step output
  outputItemId Int?
  outputItem   Item? @relation("ProsesOutputItem", fields: [outputItemId], references: [id])

  // --- Target / Standards (for Reporting) ---

  materials         ProsesMaterial[]
  productionReports ProductionReport[]
  inventoryTxns     InventoryTxn[]

  @@unique([proId, orderNo])
  @@index([proId])
}

model ProsesMaterial {
  id       Int    @id @default(autoincrement())
  prosesId Int
  proses   Proses @relation(fields: [prosesId], references: [id], onDelete: Cascade)

  itemMasterId Int
  itemMaster   Item @relation("ProsesMaterialItem", fields: [itemMasterId], references: [id])

  qtyReq Decimal @db.Decimal(12, 3)

  @@unique([prosesId, itemMasterId])
  @@index([prosesId])
  @@index([itemMasterId])
}

enum LphType {
  PAPER
  PRINTING
  PACKING_ASSEMBLY // Packing & Assembly merged as per excel structure
  BLOW_MOULDING
  INJECTION
}

enum OutputCountUom {
  pcs
  sheet
}

model ProductionReport {
  id String @id @default(cuid())

  // Header Info
  prosesId Int
  proses   Proses @relation(fields: [prosesId], references: [id])

  reportDate DateTime // Tanggal Laporan
  shift      Int // 1, 2, 3

  operatorName String

  reportType LphType

  // Common Time
  startTime DateTime? // Jam Mulai
  endTime   DateTime? // Jam Selesai

  // --- Rigid Specific Header ---
  batchNo String? // Batch No (Rigid)

  // --- Resources (Rigid) ---
  manPowerStd Int? // MP Std
  manPowerAct Int? // MP Actual

  cycleTimeStd Decimal? // CT Std (Detik)
  cycleTimeAct Decimal? // CT Actual (Detik)

  cavityStd Int? // Cavity Std (Blow/Injection)
  cavityAct Int? // Cavity Actual (Blow/Injection)

  // --- Material Usage ---
  // Paper: "Input Material"
  // Rigid (Blow/Inj): "Total Material Tuang", "Gulungan/Cucian", "Runner"
  inputMaterialQty  Decimal? @default(0) // Paper: Input Material, Rigid: Material Tuang
  materialRunnerQty Decimal? @default(0) // Rigid: PT/Runner
  materialPurgeQty  Decimal? @default(0) // Rigid: Gulungan/Cucian

  // --- Output Results ---
  qtyPassOn Decimal?        @default(0)
  qtyHold   Decimal?        @default(0)
  qtyWip    Decimal?        @default(0)
  outputUom OutputCountUom?

  qtyReject Decimal @default(0) // Total Reject

  // --- Reject Details (JSON) ---
  // Store dynamic columns like "Bintik", "Warna", "Baret", etc.
  // Format: { "bintik": 10, "warna": 5, ... }
  rejectBreakdown Json?

  // --- Downtime Details (JSON) ---
  // Store dynamic columns like "Tunggu Approval", "Setup", "Machine Problem"
  // Format: { "setup": 30, "no_order": 60, ... }
  downtimeBreakdown Json?

  totalDowntime Int @default(0) // Total menit downtime

  // --- Notes ---
  notes      String? @db.Text // Catatan Operator
  othersNote String? @db.Text // Keterangan Lain-lain (Reject)
  adminNote  String? @db.Text // Catatan Admin/Superadmin

  // Meta data for calculated fields snapshots if needed (OEE, %, etc) or extra columns
  metaData Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Verification Workflow
  status        ReportStatus @default(PENDING)
  rejectionNote String?      @db.Text
  checkedBy     User?        @relation("ReportChecker", fields: [checkedById], references: [id])
  checkedById   String?
  checkedAt     DateTime?

  // Void Audit
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  // --- Inventory & Traceability ---
  stockPostedAt DateTime? // Tanggal posting stok (jika sudah approved & posted)
  inputWipQty   Decimal?  @default(0) // Qty WIP yang dikonsumsi (optional tracking)

  inventoryTxns InventoryTxn[]

  @@index([prosesId])
  @@index([reportDate])
}

// --- Inventory System ---

enum LocationType {
  WIP
  FG
  RAW
  HOLD
  SCRAP
}

enum TxnType {
  IN
  OUT
  ADJUST
}

model InventoryLocation {
  id   Int          @id @default(autoincrement())
  code String       @unique // WIP_M_1, FG_WH, HOLD_QA
  name String
  type LocationType

  machineId Int?     @unique // Link 1-to-1 dengan mesin untuk WIP Bin
  machine   Machine? @relation(fields: [machineId], references: [id])

  txns InventoryTxn[]
}

model InventoryTxn {
  id      String   @id @default(cuid())
  groupId String   @default(cuid()) // Atomic transaction Group ID
  date    DateTime @default(now())
  type    TxnType

  itemId String // Legacy: Part Number / Material Name (kept as snapshot)
  qty    Decimal @db.Decimal(12, 3)

  // NEW: FK to master Item (nullable during migration)
  itemMasterId Int?
  itemMaster   Item? @relation(fields: [itemMasterId], references: [id])

  locationId Int
  location   InventoryLocation @relation(fields: [locationId], references: [id])

  // Traceability Links
  proId              Int?
  pro                Pro?              @relation(fields: [proId], references: [id])
  prosesId           Int?
  proses             Proses?           @relation(fields: [prosesId], references: [id])
  productionReportId String?
  productionReport   ProductionReport? @relation(fields: [productionReportId], references: [id])

  notes String?

  createdAt DateTime @default(now())

  // Prevent double posting of same item/type/location for a report
  @@unique([productionReportId, itemId, type, locationId])
  @@index([itemId])
  @@index([itemMasterId])
  @@index([date])
  @@index([groupId])
  @@index([locationId])
}
