// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  PPIC
  OPERATOR
  MASTER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @db.VarChar(255)
  role         Role     @default(ADMIN)
  department   String? // New dynamic optional field
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productionReports        ProductionReport[]
  checkedProductionReports ProductionReport[]  @relation("ReportChecker")
  createdItems             Item[]              @relation("ItemCreator")
  createdPros              Pro[]               @relation("ProCreator")
  updatedPros              Pro[]               @relation("ProUpdater")
  machineAccesses          UserMachineAccess[]
}

/// Otorisasi mesin per user (operator → mesin yang diizinkan)
model UserMachineAccess {
  id        Int     @id @default(autoincrement())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId Int
  machine   Machine @relation("MachineUserAccess", fields: [machineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, machineId])
  @@index([userId])
  @@index([machineId])
}

// Mesin

enum Uom {
  drum
  gr
  gram
  kg
  liter
  pack
  pcs
  rim
  roll
  sheet
  meter
  cm
}

enum MachineType {
  PAPER
  RIGID
}

model Machine {
  id                Int         @id @default(autoincrement())
  name              String
  stdOutputPerHour  Int
  stdOutputPerShift Int
  uom               Uom
  type              MachineType @default(PAPER)
  remark            String?

  // Rigid Specific Fields
  cycleTimeSec    Decimal? @db.Decimal(10, 3)
  cycleTimeMin    Decimal? @db.Decimal(10, 3)
  cavity          Int?
  manPower        Int?
  stdOutputPerDay Int?
  workCenter      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proses    Proses[]

  // Default Process Prefix (e.g. "FRONT", "BACK")
  defaultProPrefixId Int?
  defaultProPrefix   ProPrefix? @relation("MachineDefaultPrefix", fields: [defaultProPrefixId], references: [id])

  // User Access (otorisasi operator)
  userAccesses UserMachineAccess[] @relation("MachineUserAccess")

  // Inventory Link
  location InventoryLocation?
}

